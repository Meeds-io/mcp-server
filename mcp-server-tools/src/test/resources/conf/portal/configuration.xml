<configuration
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd http://www.exoplatform.org/xml/ns/kernel_1_2.xsd"
  xmlns="http://www.exoplatform.org/xml/ns/kernel_1_2.xsd">

  <external-component-plugins>
    <target-component>org.exoplatform.portal.config.UserPortalConfigService</target-component>
    <component-plugin>
      <name>space_templates</name>
      <set-method>initListener</set-method>
      <type>org.exoplatform.portal.config.NewPortalConfigListener</type>
      <init-params>
        <object-param>
          <name>portal.configuration</name>
          <object type="org.exoplatform.portal.config.NewPortalConfig">
            <field name="predefinedOwner">
              <collection type="java.util.HashSet">
                <value>
                  <string>community</string>
                </value>
              </collection>
            </field>
            <field name="ownerType">
              <string>group_template</string>
            </field>
            <field name="location">
              <string>jar:/conf/sites/</string>
            </field>
            <field name="override">
              <boolean>false</boolean>
            </field>
            <field name="importMode">
              <string>conserve</string>
            </field>
          </object>
        </object-param>
      </init-params>
    </component-plugin>
  </external-component-plugins>

  <remove-configuration>io.meeds.social.space.template.storage.SpaceTemplateStorage</remove-configuration>
  <remove-configuration>io.meeds.social.space.template.service.SpaceTemplateService</remove-configuration>
  <remove-configuration>org.exoplatform.social.core.jpa.search.ActivitySearchConnector</remove-configuration>
  <remove-configuration>org.exoplatform.social.core.jpa.search.ProfileSearchConnector</remove-configuration>
  <remove-configuration>org.exoplatform.services.rest.impl.provider.JAXBContextResolver</remove-configuration>
</configuration>
