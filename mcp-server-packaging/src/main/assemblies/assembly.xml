<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
  <id>auth-server-addon</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>
  <dependencySets>
    <!-- War -->
    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>${project.groupId}:*:war</include>
      </includes>
      <scope>compile</scope>
      <outputFileNameMapping>${artifact.build.finalName}.war</outputFileNameMapping>
    </dependencySet>

    <!-- Libraries -->
    <dependencySet>
      <useProjectArtifact>false</useProjectArtifact>
      <outputDirectory>/</outputDirectory>
      <includes>
        <include>*:*:jar</include>
      </includes>
      <excludes>
        <exclude>*:antlr-runtime</exclude>
        <exclude>*:antlr4-runtime</exclude>
        <exclude>*:classmate</exclude>
        <exclude>*:micrometer-observation</exclude>
        <exclude>*:micrometer-commons</exclude>
        <exclude>*:jackson-core</exclude>
        <exclude>*:jackson-databind</exclude>
        <exclude>*:jackson-annotations</exclude>
        <exclude>*:jakarta.annotation-api</exclude>
        <exclude>*:jackson-datatype-jsr310</exclude>
        <exclude>*:jackson-datatype-jdk8</exclude>
        <exclude>*:jackson-module-parameter-names</exclude>
        <exclude>*:reactor-core</exclude>
        <exclude>*:reactive-streams</exclude>
        <exclude>*:slf4j-api</exclude>
        <exclude>*:snakeyaml</exclude>
        <exclude>*:spring-webmvc</exclude>
        <exclude>*:spring-aop</exclude>
        <exclude>*:spring-beans</exclude>
        <exclude>*:spring-context</exclude>
        <exclude>*:spring-core</exclude>
        <exclude>*:spring-messaging</exclude>
        <exclude>*:spring-jcl</exclude>
        <exclude>*:spring-web</exclude>
        <exclude>*:spring-expression</exclude>
        <exclude>*:spring-boot-starter-*:*</exclude>
        <exclude>org.apache.tomcat.embed:*:*</exclude>
      </excludes>
      <scope>compile</scope>
      <outputFileNameMapping>${artifact.artifactId}.jar</outputFileNameMapping>
    </dependencySet>
  </dependencySets>
</assembly>
